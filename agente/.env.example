# OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# URLs públicas de las fotos del catálogo
PUBLIC_BASE_URL=https://rems.asesoresrm.com.ve
PROPERTIES_ROOT=/opt/docker/rems/tuasesorrm-rems/public/properties

# MySQL (mismos datos que CodeIgniter database.default.* en el .env PHP)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# API HTTP (opcional)
AGENTE_BIND=0.0.0.0
AGENTE_PORT=8090
