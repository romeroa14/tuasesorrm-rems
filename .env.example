# Fragmento para Meta / Instagram — copiar claves a tu `.env` local (no subir `.env` a git).
# Webhook + Graph API; el pipeline puede mostrar ig: @cuenta receptora.
# Callback ejemplo Live: https://TU_DOMINIO/api/webhook/instagram — mismo path GET (verify) y POST (eventos).

# Igual que "Token de verificación" en Meta. Cadena secreta corta; NO es META_GRAPH_ACCESS_TOKEN.
INSTAGRAM_VERIFY_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v21.0

# Token de Graph API (Page/User según tu configuración en Meta). Necesario también para enriquecer nombre/@usuario del cliente en CRM vía Graph.
META_GRAPH_ACCESS_TOKEN=

# Alternativa si solo usas esta variable:
# META_PAGE_ACCESS_TOKEN=

# Mapa manual de IG Business Account ID → username para zero-latency en resolveRecipientUsername().
# Ejemplo con las 4 cuentas de Asesores RM — ajustar si cambian los IDs o usernames.
# Formato: {"IG_BUSINESS_ID":"username_sin_@",...}
META_IG_RECIPIENT_USERNAMES_JSON={"17841407185102827":"migliorerossana","17841402536607139":"tuasesorrm","17841407224141177":"tiendainmueblerm","17841453409900983":"realtorsrm"}

# Pipeline CRM: columna inicial al crear lead por DM (si no se define, se usa nombre que contenga "Sin atender" o el id más bajo).
# CRM_PIPELINE_INITIAL_TRACKINGSTATUS_ID=1

# Botón Pipeline "Sync últimos DM (Meta)": hilos Graph y mensajes por hilo fusionados en BD (defaults bajos si Meta devuelve 2534084 por volumen)
# CRM_PIPELINE_SYNC_THREADS=2
# CRM_PIPELINE_SYNC_MESSAGES_PER_THREAD=10

# --- Webhook Instagram DM (Live): HTTPS público GET+POST /api/webhook/instagram ---
# INSTAGRAM_VERIFY_TOKEN=genera_un_secreto_largo_y_coincide_en_Meta_App_Webhooks
# En Meta Developers: App → Webhooks → Instagram / mensajes → URL callback + Verify Token.
# Suscribe cada Page con IG Business al producto y permisos (p. ej. instagram_manage_messages tras App Review).
#
# Opcional pero recomendado en Live: rechazar POST sin firma válida (META_APP_SECRET = App Secret del panel).
# META_WEBHOOK_REQUIRE_SIGNATURE=true
#
# --- Allowlist OPCIONAL (casos multi-app / filtro extra). NO es lista de clientes. ---
# Cada persona que te escribe por DM llega con su propio sender.id; el CRM crea lead automático sin tocar .env.
# Si NO defines estas dos variables (o las dejas vacías): se procesan TODOS los entry.id que Meta envíe a esta URL.
# Solo configúralas si quieres rechazar webhooks cuyo entry.id no sea una cuenta tuya conocida.
#
# META_WEBHOOK_ALLOWED_RECIPIENT_IG_IDS = IDs que a veces vienen en entry[].id (Instagram Business Account).
# META_WEBHOOK_ALLOWED_PAGE_IDS = Page IDs de Facebook enlazados a esas cuentas (Meta mezcla IDs en sender/recipient).
# Si usas allowlist manual y solo pones IG sin Page, algunos eventos pueden no clasificarse; con token Graph el CRM
# intenta resolver la Page vinculada. META_WEBHOOK_SKIP_LINKED_PAGE_RESOLVE=true desactiva esa consulta.
#
# Ejemplo solo si quieres hardening (varias cuentas propias):
# META_WEBHOOK_ALLOWED_RECIPIENT_IG_IDS=17841407185102827,17841407224141177,17841402536607139
# META_WEBHOOK_ALLOWED_PAGE_IDS=688678624318510,320100271194325,352566007936942
#
# IDs adicionales que Meta usa como "nosotros" al enviar DM (por si hace falta otro actor).
# META_WEBHOOK_DM_SENDER_IDS=

# Opcional — cuántos hilos DM pide Graph en meta:ig-dm-probe (default 1):
# META_PROBE_CONVERSATIONS_LIMIT=1

# Opcional — `php spark meta:ig-dm-probe` elige cuenta (orden: username > page id > primera con IG):
META_PROBE_INSTAGRAM_USERNAME=
# META_PROBE_PAGE_ID=688678624318510

# Opcional: prueba `php spark meta:connectivity` con un entry.id real del webhook
META_TEST_IG_RECIPIENT_ID=

# --- URLs Meta Developer (panel de la app): páginas públicas sin login ---
# Política de privacidad: https://TU_DOMINIO/legal/privacy-policy
# Condiciones del servicio: https://TU_DOMINIO/legal/terms-of-service
# LEGAL_ENTITY_NAME=Tu Asesor RM
# LEGAL_CONTACT_EMAIL=privacidad@tu-dominio.com
# LEGAL_PAGES_LAST_UPDATED=29 de abril de 2026

# --- Agente IA (DeepSeek) — demo CLI: php spark ai:crm-agent-demo ---
# Nunca subas la API key a git; revoca claves expuestas en chat/log.
# DEEPSEEK_API_KEY=
# Opcional: DEEPSEEK_API_BASE=https://api.deepseek.com   DEEPSEEK_MODEL=deepseek-chat
# Volcar catálogo «Aprobado» que puede usar el agente (auditoría):
# php spark ai:crm-agent-demo --catalog-approved [--catalog-limit=1000]
#
# Microservicio Python (prompt del agente + API chat): carpeta agente/ → README.md allí
# URL completa que usa CodeIgniter para proxificar el chat interno (GET app panel → POST aquí → agente):
# AI_AGENT_URL=http://127.0.0.1:8090/v1/chat

# Redis — cola de webhooks (DB 0) + cache CI4 (DB 1)
# En Docker Compose: misma clave que REMS_REDIS_PASSWORD en deploy/docker/.env
REDIS_HOST=rems-redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# Cache CI4 (handler redis, backup file). DB 1 separada de la cola.
cache.handler = redis
cache.redis.host = rems-redis
cache.redis.port = 6379
cache.redis.database = 1
# Solo si Redis tiene requirepass (producción). No dejar la línea vacía: omitir o poner la clave.
# cache.redis.password = "tu_clave_redis"
