# Fragmento para Meta / Instagram — copiar claves a tu `.env` local (no subir `.env` a git).
# Webhook + Graph API; el pipeline puede mostrar ig: @cuenta receptora.

INSTAGRAM_VERIFY_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v21.0

# Token de Graph API (Page/User según tu configuración en Meta)
META_GRAPH_ACCESS_TOKEN=

# Alternativa si solo usas esta variable:
# META_PAGE_ACCESS_TOKEN=

# Opcional: mapa manual {"entry_id_del_webhook":"usuario_sin_arroba"}
META_IG_RECIPIENT_USERNAMES_JSON=

# Pipeline CRM: columna inicial al crear lead por DM (si no se define, se usa nombre que contenga "Sin atender" o el id más bajo).
# CRM_PIPELINE_INITIAL_TRACKINGSTATUS_ID=1

# Botón Pipeline "Sync últimos DM (Meta)": hilos Graph y mensajes por hilo fusionados en BD (defaults bajos si Meta devuelve 2534084 por volumen)
# CRM_PIPELINE_SYNC_THREADS=2
# CRM_PIPELINE_SYNC_MESSAGES_PER_THREAD=10

# --- Webhook Instagram DM (Live): HTTPS público GET+POST /api/webhook/instagram ---
# INSTAGRAM_VERIFY_TOKEN=genera_un_secreto_largo_y_coincide_en_Meta_App_Webhooks
# En Meta Developers: App → Webhooks → Instagram / mensajes → URL callback + Verify Token.
# Suscribe cada Page con IG Business al producto y permisos (p. ej. instagram_manage_messages tras App Review).
#
# Opcional pero recomendado en Live: rechazar POST sin firma válida (META_APP_SECRET = App Secret del panel).
# META_WEBHOOK_REQUIRE_SIGNATURE=true
#
# Las 3 cuentas IG Business objetivo (@migliorerossana, @tiendainmueblerm, @tuasesorrm):
# META_WEBHOOK_ALLOWED_RECIPIENT_IG_IDS=17841407185102827,17841407224141177,17841402536607139
# META_WEBHOOK_ALLOWED_PAGE_IDS=688678624318510,320100271194325,352566007936942

# Opcional — cuántos hilos DM pide Graph en meta:ig-dm-probe (default 1):
# META_PROBE_CONVERSATIONS_LIMIT=1

# Opcional — `php spark meta:ig-dm-probe` elige cuenta (orden: username > page id > primera con IG):
META_PROBE_INSTAGRAM_USERNAME=
# META_PROBE_PAGE_ID=688678624318510

# Opcional: prueba `php spark meta:connectivity` con un entry.id real del webhook
META_TEST_IG_RECIPIENT_ID=


# INSTAGRAM_VERIFY_TOKEN=asesores_webhook
# META_APP_ID=...
# META_APP_SECRET=...
# META_WEBHOOK_ALLOWED_RECIPIENT_IG_IDS=17841407185102827,17841407224141177,17841402536607139
# META_WEBHOOK_ALLOWED_PAGE_IDS=688678624318510,320100271194325,352566007936942
# --- URLs Meta Developer (panel de la app): páginas públicas sin login ---
